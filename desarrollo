/* 
   2.1 Funciones como parámetros (callbacks)
                                              */

function procesarLista(arr, accion) {
    const nuevoArreglo = [];

    arr.forEach(elemento => {
        nuevoArreglo.push(accion(elemento));
    });

    return nuevoArreglo;
}


// Duplicar números
const numeros = [1, 2, 3, 4, 5];

const duplicados = procesarLista(
    numeros,
    numero => numero * 2
);

console.log(
    "Números duplicados:",
    duplicados
);


// Convertir palabras a mayúsculas
const palabras = ["javascript", "html", "css"];

const mayusculas = procesarLista(
    palabras,
    palabra => palabra.toUpperCase()
);

console.log(
    "Palabras en mayúsculas:",
    mayusculas
);


