/* 
   2.3 Validación y manejo de errores
                                        */

function dividirSeguro(a, b) {

    if (b === 0) {
        throw new Error("No se puede dividir entre cero.");
    }

    return a / b;
}


// Caso exitoso
try {

    console.log(
        "División exitosa:",
        dividirSeguro(10, 2)
    );

} catch (error) {

    console.log(
        "Error:",
        error.message
    );
}


// Caso con error
try {

    console.log(
        dividirSeguro(10, 0)
    );

} catch (error) {

    console.log(
        "Error capturado:",
        error.message
    );
}



